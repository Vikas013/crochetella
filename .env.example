# Copy this file to .env.local for local Docker or Next.js development.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project settings. Safe for browser use when using the publishable key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Server-only secrets. Never expose these in client components or commit real values.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
PAYMENT_WEBHOOK_SECRET=replace-when-payment-provider-is-added
